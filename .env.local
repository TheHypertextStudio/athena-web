# Docket — committed LOCAL defaults (safe, non-secret). Runs the full product against
# mock boundary adapters (APP_MODE=local), so no external accounts are needed.
#
# This file is TRACKED but armed with `git update-index --skip-worktree` (run on
# `pnpm install`), so your local edits are NOT seen by git — add real keys here freely.
# See docs/local-development.md. The contract/source of truth is .env.example.
#
# Footgun: if this file changes upstream, `git pull` may refuse. Recover with:
#   git update-index --no-skip-worktree .env.local && git pull && (redo your edits)
#
# NODE_ENV is intentionally NOT set here — it is framework/runtime-managed and setting
# it would poison the production build.

# ── Shared ────────────────────────────────────────────────────────────────────
APP_MODE=local
API_URL=https://api.docket.localhost
# Public origin of the product web app — the portless `docket` host (see
# docs/local-development.md). The MCP OAuth defaults derive from it.
WEB_URL=https://docket.localhost
# Portless overrides PORT with an ephemeral port in dev; fallback for non-portless runs.
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────────
# Zero-service embedded Postgres (PGlite, in-process, on-disk under .data/) — no Docker
# daemon required, matching APP_MODE=local's "no external accounts" promise. Driver is
# chosen from the URL scheme (see packages/db/src/client.ts). To use the Docker Postgres
# instead: `pnpm db:up` then set DATABASE_URL=postgres://docket:docket@localhost:5433/docket.
DATABASE_URL=pglite://.data/docket
# Optional locally (migrations reuse DATABASE_URL).
DATABASE_URL_UNPOOLED=

# ── Auth ─────────────────────────────────────────────────────────────────────────
# Shared DEV-ONLY secret (≥32 chars). NOT for production — prod sets its own.
BETTER_AUTH_SECRET=dev-local-shared-secret-not-for-production-use-0000
BETTER_AUTH_URL=https://api.docket.localhost
BETTER_AUTH_TRUSTED_ORIGINS=https://docket.localhost,https://admin.docket.localhost,https://marketing.docket.localhost
# Hosts auth may resolve its base to: web and admin each proxy /api/auth to the API, so the
# session cookie and OAuth redirect_uri must land on whichever frontend the browser is on.
BETTER_AUTH_ALLOWED_HOSTS=docket.localhost,admin.docket.localhost,api.docket.localhost
# Parent domain the session cookie is scoped to, so sibling subdomains share one session. The
# OAuth callback is handled on api.docket.localhost while the app runs on docket.localhost, and a
# host-only cookie there would be invisible to it.
BETTER_AUTH_COOKIE_DOMAIN=docket.localhost
BETTER_AUTH_PASSKEY_RP_ID=docket.localhost
BETTER_AUTH_PASSKEY_RP_NAME=Docket
# Social providers (optional) — empty ⇒ provider not mounted, UI hides it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Whether the Google consent screen is published. False locally: no Google app is configured.
GOOGLE_OAUTH_PUBLIC=false
# Google Workspace sign-in for the operator console. False locally: the group lookup authenticates
# through the GCP metadata server, so it only answers on Cloud Run. Use STAFF_BOOTSTRAP_EMAILS.
ADMIN_GOOGLE_SSO_ENABLED=false
# Both are required once SSO is on: with either missing the sync grants nothing at all.
ADMIN_GOOGLE_GROUP_ROLES=
GOOGLE_WORKSPACE_DOMAIN=
# Outbound schedule projection kill switch. False locally, since projection writes to a provider
# no local run is connected to; canonical reads, edits, and inbound bootstrap stay active.
WORK_LOCATION_PROJECTION_ENABLED=false
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_AGENT_ENABLED=false

# ── Billing (Stripe) — disabled locally ──────────────────────────────────────────
BILLING_ENABLED=false
BILLING_RECONCILIATION_MODE=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOCKET_PRICE_LOOKUP_TEAM=
DOCKET_PRICE_LOOKUP_TEAM_ANNUAL=
STRIPE_PRICE_TEAM=
STRIPE_BILLING_PORTAL_CONFIG_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── MCP remote server — enabled locally against the dev origins ──────────────────
# Mounts the Better Auth mcp() OAuth AS (authorize/token/register + consent) and
# Bearer auth on /mcp, so MCP clients — and the Playwright mcp-* e2e flows — can run
# the full register → consent → token → call chain with zero external accounts.
MCP_ISSUER_URL=https://api.docket.localhost
MCP_RESOURCE_URL=https://api.docket.localhost/mcp
MCP_ALLOWED_ORIGINS=https://docket.localhost
OIDC_LOGIN_PAGE_URL=https://docket.localhost/sign-in
MCP_TASKS_ENABLED=false
MCP_CIMD_TRUST_ALLOWLIST=
MCP_CIMD_STRICT=true
MCP_SESSION_STORE_URL=

# ── Agent runtime (optional) ─────────────────────────────────────────────────────
# Blank keeps the deterministic MockAgentRuntime, which is what APP_MODE=local wants.
ANTHROPIC_API_KEY=
# Per-session turn budget for the Athena agentic loop; the loop refuses to run without it.
AGENT_MAX_TURNS=24
# The durable Cloudflare runner stays off locally: it needs a deployed Worker plus the
# two HMAC secrets, and with it off personal Athena work runs inline as it did before.
ATHENA_ASYNC_RUNNER_ENABLED=false

# ── Ops ──────────────────────────────────────────────────────────────────────────
CRON_SECRET=dev-cron-secret-please-change-me
SENTRY_DSN=
BLOB_READ_WRITE_TOKEN=
EXPORT_BUCKET_URL=
EXPORT_BUCKET_TOKEN=
# Dev-only operator bootstrap: comma-separated `email[:role]`. Add your own address to be
# granted staff access on first /admin hit. Ignored when APP_MODE=production.
STAFF_BOOTSTRAP_EMAILS=

# ── Public (browser; Next inlines these literally) ───────────────────────────────
NEXT_PUBLIC_API_URL=https://api.docket.localhost
NEXT_PUBLIC_APP_URL=https://docket.localhost
# Browser-visible mirror of BETTER_AUTH_PASSKEY_RP_ID — MUST match it. Used by the sign-in
# flow's WebAuthn Signal API calls to prune server-deleted passkeys. No fallback.
NEXT_PUBLIC_PASSKEY_RP_ID=docket.localhost
