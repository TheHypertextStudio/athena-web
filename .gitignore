# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.next.*
.turbo/
# Alternate turbo cache directories. `turbo run <task> --cache-dir=<dir>` is how a cache-behaviour
# experiment avoids trampling the shared `.turbo/`, and each run leaves a few hundred manifest and
# meta JSON files behind. They are build output exactly as `.turbo/` is — and because Prettier
# reads this file as an ignore path, leaving them out also made `pnpm format:check` report ~150
# cache artifacts as unformatted source.
.turbo-*/
.scratch-fm/
.wrangler/
out/
*.tsbuildinfo
*.cpuprofile

# Local data (embedded PGlite database, local-disk blob store)
.data/

# Environment (per-app .env, never committed; schema lives in @docket/env)
# NOTE: the root .env.local is intentionally NOT ignored — it is committed with safe
# local defaults and protected from accidental secret commits via `git update-index
# --skip-worktree .env.local` (armed by the `prepare` script). See docs/local-development.md.
.env
.env.*.local
apps/*/.env
apps/*/.env.local
packages/*/.env
.env.vercel.*

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Agent tooling (repo-shared config under .claude/ IS committed; local-only is not)
.claude/settings.local.json
.lova.disabled/

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/
# Unanchored (no leading slash after the first segment) so it matches under any app, e.g.
# apps/web/playwright/.auth/ — these are real session-cookie-bearing files, never commit them.
**/playwright/.auth/

# NOTE: packages/db/drizzle (generated migrations) is committed — do NOT ignore it.

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/
*.tmp

# Sentry
.sentryclirc

# Next.js generated type shim (regenerated on dev/build; quote-style churns under prettier)
**/next-env.d.ts

# Playwright MCP debug artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# UI verification screenshots (captured by agents during dev sessions)
*-verify-*.png
*-verify-*.jpg

# Superpowers brainstorm visual companion
.superpowers/
.vercel/

# Bundled service worker (generated from apps/web/service-worker by the build script)
apps/web/public/sw.js

# Local scratch space for one-off audit scripts; never committed.
.scratch/

# Written on demand by `pnpm --filter @docket/api openapi:export`, for generating a client or
# diffing the surface. Deliberately not committed: it is 4.7 MB of generated JSON that changes
# with almost every API commit. `/v1/openapi.json` from the running service is the copy to trust.
apps/api/openapi.json
