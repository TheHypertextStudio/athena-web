{
  "name": "@docket/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Docket service-admin console — the staff-gated operations surface for the hosted service.",
  "portless": {
    "name": "admin.docket",
    "script": "dev:app"
  },
  "scripts": {
    "build": "next build",
    "dev": "portless run --force",
    "dev:app": "tsx ../../scripts/portless-env.ts next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location ../../node_modules/.cache/eslint/admin --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location ../../node_modules/.cache/eslint/admin --cache-strategy content",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .next .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@docket/api": "workspace:*",
    "@docket/env": "workspace:*",
    "@docket/identity-access": "workspace:*",
    "@docket/ui": "workspace:*",
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@mui/material-nextjs": "^9.1.1",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@docket/eslint-config": "workspace:*",
    "@docket/notifications": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vitest": "catalog:"
  }
}
