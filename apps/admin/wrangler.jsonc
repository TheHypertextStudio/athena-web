{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "2500680a3b2b0fe6a011c1c25fed5008",
  "name": "docket-admin-candidate",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "docket-admin-candidate",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "production": {
      "name": "docket-admin-production",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "docket-admin-production",
        },
      ],
      "vars": {
        "STUDIO_DEPLOYMENT_ENV": "production",
        "API_URL": "https://api.clearthedocket.com",
        "NEXT_PUBLIC_APP_URL": "https://admin.clearthedocket.com",
      },
      "routes": [
        {
          "pattern": "admin.clearthedocket.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
