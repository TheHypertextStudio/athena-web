{
  "name": "@docket/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Docket backend: authentication, billing and cron, the MCP server, and its API-owned RPC transport contract.",
  "exports": {
    "./rpc-contract": {
      "types": "./dist/rpc-contract.d.ts",
      "default": "./src/rpc-contract.ts"
    }
  },
  "portless": {
    "name": "api.docket",
    "script": "dev:app"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "portless run --force",
    "dev:app": "tsx ../../scripts/portless-env.ts tsx watch --include .env.local --import ./src/dev-env.ts src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint src tests",
    "pretest": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "pretest:coverage": "tsc -p tsconfig.build.json",
    "test:coverage": "vitest run --coverage --exclude tests/work-views/performance.test.ts",
    "test:performance": "vitest run tests/work-views/performance.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@docket/auth": "workspace:*",
    "@docket/authz": "workspace:*",
    "@docket/athena": "workspace:*",
    "@docket/automation": "workspace:*",
    "@docket/billing": "workspace:*",
    "@docket/blob-store": "workspace:*",
    "@docket/connections": "workspace:*",
    "@docket/db": "workspace:*",
    "@docket/env": "workspace:*",
    "@docket/identity-access": "workspace:*",
    "@docket/integrations": "workspace:*",
    "@docket/mail": "workspace:*",
    "@docket/markdown-tree": "workspace:*",
    "@docket/notifications": "workspace:*",
    "@docket/types": "workspace:*",
    "@docket/work": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@hono/standard-validator": "catalog:",
    "@lovelace-ai/lattice-relay-client": "^0.0.1",
    "@lovelace-ai/lattice-relay-crypto": "^0.0.1",
    "@modelcontextprotocol/sdk": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "^0.8.3",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "marked": "catalog:",
    "tsx": "^4.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@docket/eslint-config": "workspace:*",
    "@docket/test-utils": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@dotenvx/dotenvx": "^2.6.0",
    "@standard-schema/spec": "^1.0.0",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
