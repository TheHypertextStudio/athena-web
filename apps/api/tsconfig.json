{
  "extends": "@docket/tsconfig/base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // Acceptance tests deliberately import sibling package sources; this checking-only program
    // must include the monorepo, while tsconfig.build.json keeps its source root at src.
    "rootDir": "../..",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
