{
  "extends": ["//"],
  // The Hono API validates the full server env contract (`@docket/env/api`) when it boots, so
  // its long-running `dev` server needs every server-var group made available under strict mode.
  // These live here — not in the root globalEnv — so they only invalidate API caches, never the
  // Next apps'. `build` is `tsc` (no runtime env) and `test` sets its own env, so neither needs them.
  "tasks": {
    // `BLOB_READ_WRITE_TOKEN` is set on the Vercel project and read only at runtime, but under
    // `envMode: "strict"` turbo withholds anything undeclared and warns that the build may fail.
    // `passThroughEnv` hands it to the build without adding it to the cache key, so rotating the
    // blob token does not invalidate a build that never reads it.
    "build": {
      "passThroughEnv": ["BLOB_READ_WRITE_TOKEN"]
    },
    // `tests/core/infra.test.ts` compares the published RPC contract against the router source, and
    // it reads the contract from `dist/rpc-contract.d.ts`. Ordering that build here rather than in
    // a `pretypecheck` hook is what keeps it safe: `test` already depends on `build`, so a hook
    // would have left two unordered tasks emitting the same declarations concurrently. Turbo also
    // caches the build instead of re-running `tsc` on every typecheck.
    "typecheck": {
      "dependsOn": ["build"]
    },
    "dev": {
      "env": [
        "WEB_URL",
        "BETTER_AUTH_*",
        "OAUTH_PROXY_*",
        "GOOGLE_*",
        "WORK_LOCATION_*",
        "GITHUB_*",
        "LINEAR_*",
        "LATTICE_*",
        "MCP_*",
        "OIDC_*",
        "STRIPE_*",
        "DOCKET_PRICE_*",
        "ATHENA_*",
        "ANTHROPIC_API_KEY",
        "AGENT_MAX_TURNS",
        "ATHENA_MAX_CONCURRENT_RUNS",
        "CRON_SECRET",
        "CREDENTIALS_ENCRYPTION_KEY",
        "SENTRY_DSN",
        "BLOB_READ_WRITE_TOKEN",
        "EXPORT_BUCKET_*",
        "BILLING_ENABLED",
        "BILLING_RECONCILIATION_MODE",
        "SMTP_*",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "STAFF_BOOTSTRAP_EMAILS"
      ]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:coverage": {
      "dependsOn": ["build"]
    }
  }
}
