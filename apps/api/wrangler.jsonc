{
  "account_id": "2500680a3b2b0fe6a011c1c25fed5008",
  "name": "docket-api-production",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.clearthedocket.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "containers": [
    {
      "class_name": "DocketApiContainer",
      "image": "./cloudflare/Dockerfile",
      "image_build_context": "./dist",
      "instance_type": "basic",
      "max_instances": 4,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCKET_API_CONTAINER",
        "class_name": "DocketApiContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocketApiContainer"],
    },
  ],
  "vars": {
    "APP_MODE": "production",
    "API_URL": "https://api.clearthedocket.com",
    "WEB_URL": "https://clearthedocket.com",
    "PUBLIC_BRIEF_HOST": "briefs.clearthedocket.com",
    "CUSTOM_DOMAIN_CNAME_TARGET": "briefs.clearthedocket.com",
    "BETTER_AUTH_URL": "https://api.clearthedocket.com",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://clearthedocket.com,https://admin.clearthedocket.com",
    "BETTER_AUTH_ALLOWED_HOSTS": "docket.hypertext.studio,docket-api.hypertext.studio,docket-admin.hypertext.studio,clearthedocket.com,api.clearthedocket.com,admin.clearthedocket.com",
    "BETTER_AUTH_PASSKEY_RP_ID": "clearthedocket.com",
    "BETTER_AUTH_PASSKEY_LEGACY_RP_ID": "hypertext.studio",
    "BETTER_AUTH_PASSKEY_RP_NAME": "Docket",
    "BETTER_AUTH_PASSKEY_NATIVE_ORIGINS": "android:apk-key-hash:3zJp1NzJxP5y_mFioPTp7l8EFEfcs472qSV2_DiQ28c,android:apk-key-hash:QcmZeU6GHcumm8Yif8jJo4jlRcItrzp7cE4zoKlsVUI",
    "APPLE_APP_CLIENT_ID": "studio.hypertext.docket",
    "GOOGLE_CALENDAR_WEBHOOK_URL": "https://api.clearthedocket.com/webhooks/calendar/google",
    "GOOGLE_OAUTH_PUBLIC": "true",
    "GOOGLE_OAUTH_TEST_EMAILS": "willieechalmers@gmail.com",
    "ADMIN_GOOGLE_SSO_ENABLED": "false",
    "WORK_LOCATION_PROJECTION_ENABLED": "false",
    "LINEAR_AGENT_ENABLED": "false",
    "BILLING_ENABLED": "false",
    "BILLING_RECONCILIATION_MODE": "off",
    "STRIPE_HYPERTEXT_STUDIO_ACCOUNT_ID": "acct_1TTQ9DAREPz33Avb",
    "STRIPE_SINGLE_SUBSCRIPTION_REDIRECT_VERIFIED_AT": "2026-08-28T22:15:55Z",
    "MCP_TASKS_ENABLED": "false",
    "AGENT_MAX_TURNS": "24",
    "ATHENA_ASYNC_RUNNER_ENABLED": "false",
    "ATHENA_INBOUND_MAIL_HOST": "mail.clearthedocket.com",
