{
  "name": "@docket/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "The Docket product application.",
  "portless": {
    "name": "docket",
    "script": "dev:app"
  },
  "scripts": {
    "build": "next build && tsx ../../packages/service-worker/bin/build.ts --app-root=. --production",
    "dev": "portless run --force",
    "dev:app": "tsx ../../scripts/portless-env.ts sh -c 'tsx ../../packages/service-worker/bin/build.ts --app-root=. && next dev'",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" vitest run",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" vitest",
    "test:coverage": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .turbo *.tsbuildinfo",
    "test:e2e:evidence": "E2E_EVIDENCE=1 playwright test"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@docket/api": "workspace:*",
    "@docket/env": "workspace:*",
    "@docket/integrations": "workspace:*",
    "@docket/notifications": "workspace:*",
    "@docket/types": "workspace:*",
    "@docket/ui": "workspace:*",
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@mui/material-nextjs": "^9.0.1",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tiptap/core": "3.27.3",
    "@tiptap/extension-code-block": "3.27.3",
    "@tiptap/extension-link": "3.27.3",
    "@tiptap/extension-list": "3.27.3",
    "@tiptap/markdown": "3.27.3",
    "@tiptap/pm": "3.27.3",
    "@tiptap/react": "3.27.3",
    "@tiptap/starter-kit": "3.27.3",
    "@xyflow/react": "^12.11.1",
    "better-auth": "catalog:",
    "dagre": "^0.8.5",
    "highlight.js": "^11.11.1",
    "hono": "catalog:",
    "idb-keyval": "^6.3.0",
    "lowlight": "^3.3.0",
    "marked": "17.0.6",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@docket/brand": "workspace:*",
    "@docket/eslint-config": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
