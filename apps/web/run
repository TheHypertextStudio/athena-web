#!/bin/sh
# Generated from TheHypertextStudio/release-engineering. Update through its renderer.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
version='v0.1.8'
expected='61f746429fc0ffc7826df2bde61ee4d41323fb5fa0c9f8661255040e7838afd4'
repo='TheHypertextStudio/release-engineering'
fail() { printf '%s\n' "studio: $*" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || fail 'Python 3.11 or newer is required.'
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || fail 'Python 3.11 or newer is required.'
cache="${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}/hypertext-studio/release-engineering/$version"
engine="$cache/studio.pyz"
digest() { python3 -c 'import hashlib,sys; print(hashlib.file_digest(sys.stdin.buffer,"sha256").hexdigest())'; }
if [ ! -f "$engine" ] || [ "$(digest < "$engine")" != "$expected" ]; then
    [ "${1:-}" = setup ] || fail 'Engine cache is missing or corrupt; run ./run setup first.'
    for argument in "$@"; do [ "$argument" != --offline ] || fail 'Offline setup requires a verified cached engine.'; done
    mkdir -p "$cache"
    staging=$(mktemp -d "$cache/.download.XXXXXXXX")
    trap 'rm -rf "$staging"' EXIT HUP INT TERM
    downloaded=no
    if command -v curl >/dev/null 2>&1; then
        if curl --fail --location --silent --show-error --connect-timeout 20 --max-time 300 \
            "https://github.com/$repo/releases/download/$version/studio.pyz" -o "$staging/studio.pyz"; then
            downloaded=yes
        fi
    fi
    if [ "$downloaded" = no ] && command -v gh >/dev/null 2>&1; then
        rm -f "$staging/studio.pyz"
        if gh release download "$version" --repo "$repo" --pattern studio.pyz --dir "$staging"; then downloaded=yes; fi
    fi
    [ "$downloaded" = yes ] || fail 'Could not download the pinned lifecycle release.'
    [ "$(digest < "$staging/studio.pyz")" = "$expected" ] || fail 'Downloaded lifecycle SHA-256 does not match its pin.'
    mv -f "$staging/studio.pyz" "$engine"
    rm -rf "$staging"
    trap - EXIT HUP INT TERM
fi
exec python3 "$engine" --root "$root" "$@"
