{
  "extends": [
    "@thehypertextstudio/web-config/tsconfig/browser.json",
    "@docket/tsconfig/nextjs.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "build-worker-shipping.mjs"
  ],
  "exclude": ["node_modules", ".next", "dist", "vite.config.ts", "e2e", "service-worker"]
}
