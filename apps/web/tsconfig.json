{
  "extends": [
    "@thehypertextstudio/web-config/tsconfig/browser.json",
    "@docket/tsconfig/nextjs.json"
  ],
  "compilerOptions": {
    "allowJs": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".next",
    ".open-next",
    "dist",
    "vite.config.ts",
    "e2e",
    "service-worker"
  ]
}
