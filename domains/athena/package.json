    "./turn/adapters/anthropic": {
      "types": "./src/turn/adapters/anthropic.ts",
      "default": "./src/turn/adapters/anthropic.ts"
    },
    "./turn/adapters/lattice": {
      "types": "./src/turn/adapters/lattice.ts",
      "default": "./src/turn/adapters/lattice.ts"
    },
    "./turn/model-backend": {
      "types": "./src/turn/model-backend.ts",
