      "default": "./src/elicitation-api.ts"
    },
    "./turn-protocol": {
      "types": "./src/turn-protocol.ts",
      "default": "./src/turn-protocol.ts"
    },
    "./agent-session": {
      "types": "./src/agent-session.ts",
      "default": "./src/agent-session.ts"
    },
    "./agent-bus": {
      "types": "./src/agent-bus.ts",
      "default": "./src/agent-bus.ts"
    },
    "./conversation": {
      "types": "./src/conversation.ts",
      "default": "./src/conversation.ts"
    },
    "./voice": {
      "types": "./src/voice.ts",
      "default": "./src/voice.ts"
    },
    "./phone": {
      "types": "./src/phone.ts",
      "default": "./src/phone.ts"
    },
    "./digest": {
      "types": "./src/digest.ts",
