{
  "name": "@docket/athena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Athena domain contracts and pure execution rules shared by its delivery runtimes.",
  "exports": {
    "./execution-protocol": {
      "types": "./src/execution-protocol.ts",
      "default": "./src/execution-protocol.ts"
    },
    "./elicitation": {
