    "./task-drafting/adapters/deterministic": {
      "types": "./src/task-drafting/adapters/deterministic.ts",
      "default": "./src/task-drafting/adapters/deterministic.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .turbo *.tsbuildinfo"
