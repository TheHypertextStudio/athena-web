    "./notion/mirror-values": "./src/notion/mirror-values.ts",
    "./notion/mirror-port": "./src/notion/mirror-port.ts",
    "./notion/adapters/notion-sdk": "./src/notion/adapters/notion-sdk.ts",
    "./notion/adapters/in-memory": "./src/notion/adapters/in-memory.ts",
    "./activity-contract": "./src/contracts/activity.ts",
    "./event-contract": "./src/contracts/event.ts",
    "./integration-contract": "./src/contracts/integration.ts",
    "./provider-catalog-contract": "./src/contracts/provider-catalog.ts",
    "./resource-provider-contract": "./src/contracts/resource-provider.ts",
