{
  "name": "@docket/root",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Docket - workflow platform monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHypertextStudio/athena-web.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "dotenv -e .env.local -- env NODE_ENV=production turbo run build",
    "dev": "dotenv -e .env.local -- turbo run dev",
    "dev:stack": "sh scripts/dev-stack.sh",
    "lint": "turbo run lint --concurrency=2",
    "lint:staged": "lint-staged",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck typecheck:repo",
    "typecheck:repo": "tsc --noEmit",
    "test": "turbo run test:coverage test:tooling --concurrency=2",
    "test:tooling": "vitest run repo-tests",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:release": "scripts/run-release-acceptance.sh",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "ci:gate-policy": "tsx scripts/ci-gate-policy.ts",
    "complexity:ledger": "tsx scripts/complexity-ledger.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "secret:paste": "tsx scripts/set-secret-from-clipboard.ts",
    "notion:webhook-token": "tsx scripts/notion-webhook-token.ts",
    "sync:failure": "tsx scripts/sync-failure.ts",
    "launch:record": "tsx scripts/launch-record.ts",
    "launch:scorecard": "tsx scripts/launch-scorecard.ts",
    "launch:verify-native-auth": "tsx scripts/native-passkey-origin-verify.ts",
    "launch:verify-prod": "tsx scripts/production-verify.ts",
    "placeholders:inventory": "tsx scripts/placeholder-inventory.ts",
    "placeholders:check": "tsx scripts/placeholder-inventory.ts --check",
    "icons": "pnpm --filter @docket/brand icons",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "integrations": "tsx scripts/integrations-setup.ts",
    "linear-agent:sandbox-check": "tsx scripts/linear-agent-sandbox-check.ts",
    "env:check": "tsx scripts/env-check.ts",
    "domain:check": "tsx scripts/domain-check.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "workspaces:provision": "tsx scripts/provision-workspaces.ts",
    "sunsama:import": "tsx scripts/import-sunsama.ts",
    "check:context-strategy": "tsx scripts/context-strategy-check.ts",
    "scheduler:setup": "dotenv -e .env.local -- tsx scripts/scheduler-setup.ts",
    "billing:launch-audit": "dotenv -e .env.local -- tsx scripts/billing-launch-audit.ts",
    "proxy:install": "portless service install",
    "proxy:status": "portless service status",
    "proxy:uninstall": "portless service uninstall",
    "db:up": "dotenv -e .env.local -- tsx scripts/db-up.ts",
    "db:down": "docker compose down",
    "db:reset": "dotenv -e .env.local -- tsx scripts/db-reset.ts",
    "db:seed:staff": "dotenv -e .env.local -- tsx scripts/seed-staff.ts",
    "db:generate": "dotenv -e .env.local -- turbo run db:generate --filter=@docket/db",
    "db:migrate": "dotenv -e .env.local -- turbo run db:migrate --filter=@docket/db",
    "db:studio": "dotenv -e .env.local -- turbo run db:studio --filter=@docket/db",
    "search:backfill": "dotenv -e .env.local -- tsx scripts/search-backfill.ts",
    "search:repair": "dotenv -e .env.local -- tsx scripts/search-backfill.ts --repair",
    "search:process": "dotenv -e .env.local -- tsx scripts/search-process-jobs.ts",
    "prepare": "if [ -f scripts/install-git-guardrails.sh ]; then sh scripts/install-git-guardrails.sh; fi && (git update-index --skip-worktree .env.local 2>/dev/null || true)"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@docket/test-utils": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "lint-staged": "^17.0.8",
    "portless": "catalog:",
    "postgres": "catalog:",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.15 <27",
    "pnpm": ">=11.0.0"
  }
}
