{
  "name": "@docket/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Docket authentication — the Better Auth configuration and passwordless sign-up challenge.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@docket/db": "workspace:*",
    "@docket/env": "workspace:*",
    "@docket/mail": "workspace:*",
    "@docket/notifications": "workspace:*",
    "@docket/types": "workspace:*",
    "@simplewebauthn/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@docket/eslint-config": "workspace:*",
    "@docket/test-utils": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
