{
  "name": "@docket/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Third-party provider connectors, observers, fixtures, and integration test doubles.",
  "exports": {
    ".": "./src/index.ts",
    "./mcp-apps": "./src/mcp-apps.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:mcp-map-interop": "tsx tests/mcp/run-map-interop.ts",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@docket/connections": "workspace:*",
    "@docket/env": "workspace:*",
    "@docket/types": "workspace:*",
    "@docket/work": "workspace:*",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@notionhq/client": "^5.24.0",
    "parse5": "8.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@docket/eslint-config": "workspace:*",
    "@docket/test-utils": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@modelcontextprotocol/server-map": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
