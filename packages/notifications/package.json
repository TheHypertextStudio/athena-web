{
  "name": "@docket/notifications",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Docket notifications domain — schemas, policy, delivery orchestration, inbox state, and provider event handling.",
  "exports": {
    ".": "./src/index.ts",
    "./dispatch": "./src/dispatch/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./testing": "./src/testing/index.ts",
    "./webpush": "./src/webpush/index.ts",
    "./webpush/node": "./src/webpush/node.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@docket/athena": "workspace:*",
    "@docket/db": "workspace:*",
    "@docket/integrations": "workspace:*",
    "@docket/mail": "workspace:*",
    "@docket/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@docket/eslint-config": "workspace:*",
    "@docket/test-utils": "workspace:*",
    "@docket/tsconfig": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
