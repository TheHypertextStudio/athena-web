#!/bin/sh
# Generated by Hypertext Studio bootstrap. Update pins with render-launcher.py.
set -eu
version='v0.1.0'
repo='TheHypertextStudio/release-engineering'
fail() { printf '%s\n' "bootstrap: $*" >&2; exit 1; }
[ "${1:-}" = worktree ] || fail 'Only worktree prepare, check, and plan are supported.'
case "${2:-}" in prepare) writable=yes ;; check|plan) writable=no ;; *) fail 'Expected worktree prepare, check, or plan.' ;; esac
offline=no
for argument in "$@"; do [ "$argument" != --offline ] || offline=yes; done
case "$(uname -s)" in Darwin) os=darwin ;; Linux) os=linux ;; *) fail 'Unsupported operating system.' ;; esac
case "$(uname -m)" in arm64|aarch64) arch=arm64 ;; x86_64|amd64) arch=x86_64 ;; *) fail 'Unsupported architecture.' ;; esac
platform="$os-$arch"
case "$platform" in
    darwin-arm64) expected='e9bf82f425f46222c48f52bc81223ca1e74c51abba7b8029817b8326f2e563fa' ;;
    darwin-x86_64) expected='0e3257e19f3e7e34bf55b5822b6e0c02f8c6c8433e7fb0351099bd403fdfe305' ;;
    linux-arm64) expected='eb89f9336a3f7148dfac99913a6a74bc9958d00c75a01e44a08d197d8bd5724c' ;;
    linux-x86_64) expected='d3800739ac58c463d9febc5ed7501f03ad64fccec525953d7427386affff1c4f' ;;
esac
asset="hypertext-bootstrap-$platform.tar.gz"
cache="${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}/hypertext-studio/bootstrap/$version/$platform"
archive="$cache/$asset"
engine="$cache/hypertext-bootstrap"
command -v tar >/dev/null 2>&1 || fail 'tar is required.'
if command -v sha256sum >/dev/null 2>&1; then
    digest() { sha256sum | cut -d ' ' -f 1; }
elif command -v shasum >/dev/null 2>&1; then
    digest() { shasum -a 256 | cut -d ' ' -f 1; }
else
    fail 'sha256sum or shasum is required.'
fi
valid_cache() {
    [ -f "$archive" ] && [ -x "$engine" ] || return 1
    [ "$(digest < "$archive")" = "$expected" ] || return 1
    wanted=$(tar -xOf "$archive" hypertext-bootstrap | digest) || return 1
    [ "$(digest < "$engine")" = "$wanted" ]
}
if ! valid_cache; then
    [ "$writable" = yes ] || fail 'Engine cache is missing or corrupt; run ./bootstrap worktree prepare first.'
    [ "$offline" = no ] || fail 'Engine cache is missing or corrupt and --offline prohibits downloads.'
    mkdir -p "$cache"
    staging=$(mktemp -d "$cache/.download.XXXXXXXX")
    trap 'rm -rf "$staging"' EXIT HUP INT TERM
    downloaded=no
    if command -v curl >/dev/null 2>&1; then
        if curl --fail --location --silent --show-error --connect-timeout 20 --max-time 300 \
            "https://github.com/$repo/releases/download/$version/$asset" -o "$staging/$asset"; then
            downloaded=yes
        fi
    fi
    if [ "$downloaded" = no ] && command -v gh >/dev/null 2>&1; then
        rm -f "$staging/$asset"
        if gh release download "$version" --repo "$repo" --pattern "$asset" --dir "$staging"; then
            downloaded=yes
        fi
    fi
    [ "$downloaded" = yes ] || fail 'Download failed. Install curl, or authenticate gh for private GitHub releases.'
    [ "$(digest < "$staging/$asset")" = "$expected" ] || fail 'Downloaded archive SHA-256 does not match its release pin.'
    tar -xOf "$staging/$asset" hypertext-bootstrap > "$staging/hypertext-bootstrap"
    [ -s "$staging/hypertext-bootstrap" ] || fail 'Release archive contains an empty engine.'
    chmod 755 "$staging/hypertext-bootstrap"
    # Each concurrent writer installs identical verified bytes through atomic renames.
    mv -f "$staging/$asset" "$archive"
    mv -f "$staging/hypertext-bootstrap" "$engine"
    rm -rf "$staging"
    trap - EXIT HUP INT TERM
fi
exec "$engine" "$@"
