{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "envMode": "strict",
  // Only TRULY cross-cutting vars live here (they bust every task's cache). App/service-specific
  // groups (BETTER_AUTH_*, STRIPE_*, MCP_*, GOOGLE_*, …) are declared in the consuming package's
  // turbo.json instead, so e.g. rotating a Stripe key no longer invalidates the web/admin caches.
  "globalEnv": [
    "NODE_ENV",
    "APP_MODE",
    "CI",
    "PORT",
    "API_URL",
    "WEB_URL",
    "SKIP_ENV_VALIDATION",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED"
  ],
  "globalPassThroughEnv": ["VERCEL", "VERCEL_*", "PORTLESS_*"],
  // Remote cache is signed (HMAC over artifacts). Inert until a cache is configured: with no
  // TURBO_TOKEN/TURBO_API set, turbo silently uses the local cache only. CI supplies the token +
  // TURBO_REMOTE_CACHE_SIGNATURE_KEY from secrets — see .github/workflows/ci.yml.
  "remoteCache": { "signature": true },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Docs-only edits and test-only changes never change build output — keep them
      // out of the cache key so that editing a .test.ts file in a dependency no longer
      // invalidates the web build (and the Vercel deploy it triggers).
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "!tests/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Bring the DB up and migrated before any app server starts, natively via the task
      // graph: dev → (^)db:migrate → //#db:up. Apps that don't depend on @docket/db
      // (marketing) simply skip it. Replaces the old `db:up && db:migrate &&` shell chain.
      "dependsOn": ["^db:migrate"]
    },
    // Most lint/typecheck/test tasks do not depend on `^build`: JIT workspace packages expose raw
    // TS, so tsc/eslint/vitest resolve dependency source directly. Delivery apps that consume the
    // compiled `@docket/api/rpc-contract` declaration name that one necessary API build in their
    // local turbo configs instead of making every workspace task build every dependency.
    // A transit node: no package implements `topo`, and it runs nothing. It exists so that the
    // check tasks below inherit a dependency edge on every workspace dependency, which is what
    // puts an upstream package's hash into a downstream task's cache key.
    //
    // Without it those tasks had NO `dependsOn` at all, and turbo's key is the package's own
    // files + task definition + env + the hashes of tasks named in `dependsOn`. So a breaking
    // change in @docket/types contributed nothing to @docket/work#typecheck's key and turbo
    // replayed a cached PASS. (`turbo run typecheck --filter=@docket/work --dry=json` reported
    // `dependencies: []`.) The three delivery apps were correct only for the one dependency that
    // has a build — @docket/api#build, declared in their own turbo.json — while all 21
    // JIT-source edges went unmodelled.
    //
    // A transit node rather than `^typecheck`/`^lint`/`^test`: it chains the hashes without
    // forcing every dependency's check to finish before a dependent's may start, so the graph
    // stays as parallel as it was while the key becomes correct.
    "topo": {
      "dependsOn": ["^topo"]
    },
    // `topo` chains every workspace dependency into the key, which covers the shared preset
    // package. `eslint.config.js` is the one file it cannot: it sits at the repo root and
    // belongs to no package, so without naming it a package's cached PASS replays after the
    // composed config changes.
    "lint": {
      "dependsOn": ["topo"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/tooling/eslint-config/index.js",
        "$TURBO_ROOT$/tooling/eslint-config/complexity-debt.json"
      ]
    },
    // Never cacheable: this rewrites source files in place, and its `outputs` are those same
    // input files rather than an artifact turbo can restore. A cached replay would report success
    // and apply no fixes.
    "lint:fix": {
      "dependsOn": ["topo"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test": {
      "dependsOn": ["topo"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["topo"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // `cache: false`, because the inputs that decide this task's result are not all in the graph:
    // the suite runs against a live @docket/api server and a migrated database, both started
    // outside turbo by CI. Left cacheable, a change confined to apps/api kept
    // @docket/web#test:e2e cache-valid and replayed a green run that never exercised the change.
    // The API build and the migration are named as well, so a direct invocation still orders them.
    "test:e2e": {
      "dependsOn": ["build", "@docket/api#build", "^db:migrate"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "clean": {
      "cache": false
    },
    // Root-package tasks. Both are `cache: false` on purpose: each reads far outside any one
    // package — `typecheck:repo` compiles `scripts/` and `repo-tests/`, which import from
    // `apps/api/src`, `domains/billing/src`, and `packages/*` by relative path, and the
    // `repo-tests/` suites additionally read `.github/workflows/*`, every workspace manifest, and
    // several `docs/` files. An `inputs` list that missed one of those would cache a stale PASS,
    // which is the exact failure the `topo` node above exists to prevent. Both are seconds long,
    // so there is nothing to win by risking it.
    "//#typecheck:repo": {
      "cache": false
    },
    "//#test:tooling": {
      "cache": false
    },
    // Root task (runs the root `db:up` script, which is scheme-aware: it starts + waits on
    // the Docker Postgres for a `postgres:`/`neon:` DATABASE_URL, and is a no-op for the
    // embedded `pglite:` mode). db:migrate depends on it, so a TCP DB is healthy before
    // migrations run, while the zero-service PGlite mode needs no daemon.
    "//#db:up": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": ["//#db:up"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
